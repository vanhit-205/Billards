<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Phần tiêu đề vẫn giữ style Admin nhưng bỏ padding ngoài -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/tvStaffTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Nhân Viên"
            android:textColor="@color/foreground"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/staffTabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:tabIndicatorColor="@color/blue_600"
            app:tabIndicatorHeight="2dp"
            app:tabSelectedTextColor="@color/blue_600"
            app:tabTextColor="@color/muted_foreground"
            app:tabRippleColor="@android:color/transparent"
            app:tabTextAppearance="@style/TabTextAppearance"
            app:tabIconTint="@color/tab_icon_selector">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/payment"
                android:text="Thanh toán" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/order"
                android:text="Order" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>

    <!-- ViewPager2 chiếm toàn bộ phần còn lại -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/staffViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
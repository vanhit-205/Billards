<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Billards" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        
        <!-- Mặc định cho các MaterialButton -->
        <item name="materialButtonStyle">@style/Widget.Billards.Button.Primary</item>
    </style>

    <style name="Theme.Billards" parent="Base.Theme.Billards" />

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Style cho nút giống nút Thêm nhân viên -->
    <style name="Widget.Billards.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blue_600</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>